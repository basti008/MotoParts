<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_B2" targetNamespace="https://motoparts.local/bpmn">
  <collaboration id="Collab_B2" name="Checkout integration">
    <participant id="UserPool" name="Customer" processRef="Customer_B2"/>
    <participant id="SystemPool" name="MotoParts System" processRef="System_B2"/>
    <participant id="OpenMeteoPool" name="Open-Meteo Geocoding API"/>
  </collaboration>
  <process id="Customer_B2" name="Customer checkout" isExecutable="false"><startEvent id="s" name="Checkout"/><task id="fill" name="Submit delivery information"/><endEvent id="e" name="Receive order result"/><sequenceFlow id="c1" sourceRef="s" targetRef="fill"/><sequenceFlow id="c2" sourceRef="fill" targetRef="e"/></process>
  <process id="System_B2" name="MotoParts integration" isExecutable="false">
    <startEvent id="s2" name="POST /api/orders/checkout"/>
    <task id="validate" name="Validate order data"/>
    <task id="geocode" name="Look up delivery city"/>
    <exclusiveGateway id="found" name="Location found?"/>
    <task id="map" name="Map provider data to canonical location"/>
    <task id="save" name="Save enriched order to orders.json"/>
    <endEvent id="ok" name="201 Created"/>
    <endEvent id="bad" name="400 / 404"/>
    <sequenceFlow id="s1" sourceRef="s2" targetRef="validate"/>
    <sequenceFlow id="s2" sourceRef="validate" targetRef="geocode"/>
    <sequenceFlow id="s3" sourceRef="geocode" targetRef="found"/>
    <sequenceFlow id="s4" sourceRef="found" targetRef="map"><conditionExpression>yes</conditionExpression></sequenceFlow>
    <sequenceFlow id="s5" sourceRef="found" targetRef="bad"><conditionExpression>no</conditionExpression></sequenceFlow>
    <sequenceFlow id="s6" sourceRef="map" targetRef="save"/>
    <sequenceFlow id="s7" sourceRef="save" targetRef="ok"/>
  </process>
</definitions>
